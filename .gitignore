# macOS Finder metadata.
**/.DS_Store

# Local saves / credentials.
**/account.txt
**/.env
**/.env.*
**/*.pfx
**/*.pem
**/*.key
**/user.dat
**/save/

# Converted game content (derived from the original client's files; not checked into Git). No
# trailing slash: this is a symlink on dev machines, and a trailing slash would only match a
# real directory.
/source/new-client/godot/content

# Local offline NuGet source (the Godot .NET build's own GodotSharp packages); a per-machine
# symlink/copy, not part of the source checkout.
/source/new-client/tools/godot_net/

# Generated output and local caches.
**/bin/
**/obj/
**/.godot/
**/TestResults/
**/__pycache__/
**/*.pyc
**/*.log
**/*.dmp
**/*.trx
**/*.nettrace
**/developer-state/
**/.vs/
/artifacts/

# Dev-only switch; never ship or commit it.
/source/new-client/godot/dev_mode.txt
